  {
    "scenario_id": "self_improving_match",
    "description": "Agent critiques and improves its own match analysis",
    "conversation": [
      {
        "turn": 1,
        "user": "show my top match",
        "expected_tools": ["DatabaseQueryPlugin.query_database_with_ai"],
        "assertions": ["returns top match"]
      },
      {
        "turn": 2,
        "user": "can you re-evaluate and improve the analysis for this match",
