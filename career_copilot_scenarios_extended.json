  {
    "scenario_id": "job_search_explore_save",
    "description": "User searches for jobs, explores specific ones, and saves a subset",
    "conversation": [
      {
        "turn": 1,
        "user": "find me ai engineer jobs in chicago",
        "expected_tools": ["JobPlugin.find_jobs"],
        "assertions": ["returns ~10 jobs", "stores last_searched_jobs in memory"]
      },
      {
        "turn": 2,
        "user": "tell me more about job number 3",
        "expected_tools": ["JobPlugin.get_job_details"],
        "assertions": ["references last search", "returns details for job index 3"]
      },
      {
        "turn": 3,
        "user": "save jobs 3 and 6",
        "expected_tools": ["JobPlugin.save_searched_jobs"],
        "assertions": ["saves only specified jobs", "confirms saved count"]
      }
    ]
  },
